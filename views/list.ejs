<%- include("partials/header", { title: "All Books" }) %>

<h1>All Books</h1>

<% if (books.length === 0) { %>
  <p class="empty">No books yet. <a href="/books/new">Add the first one.</a></p>
<% } else { %>
  <div class="grid">
    <% books.forEach(function (book) { %>
      <article class="card">
        <a href="/books/<%= book.bookId %>">
          <% if (book.imageUrl) { %>
            <img class="cover" src="<%= book.imageUrl %>" alt="<%= book.title %> cover" />
          <% } else { %>
            <div class="cover placeholder">No cover</div>
          <% } %>
          <h3><%= book.title %></h3>
        </a>
        <p class="author"><%= book.author %></p>
        <p class="category"><%= book.category %></p>
      </article>
    <% }); %>
  </div>
<% } %>

<%- include("partials/footer") %>
